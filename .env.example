# Numero da consultora no WhatsApp, formato internacional apenas com digitos
VITE_WHATSAPP_NUMBER=5511999999999

# Planilha do catálogo, lida só no build (Node). Sem o prefixo VITE_ de
# propósito: o Vite só embute no bundle as variáveis com esse prefixo.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_API_KEY=

# Aba lida no build. Vazia: "produtos" em produção, "produtos_preview" no resto.
CATALOG_SHEET_TAB=

# 1 = num preview da Vercel, planilha inválida usa products.mock.ts e o
# disjuntor de imagens vira aviso, em vez de falhar o build. Ignorada em
# qualquer outro ambiente.
ALLOW_STALE_CATALOG=

# Nome da conta no Cloudinary (aparece em toda URL, nao e segredo). Com ele,
# produto sem imagem_url usa https://res.cloudinary.com/<nome>/image/upload/<id>.jpg
CLOUDINARY_CLOUD_NAME=
